#!/command/with-contenv bashio
set -e
certificate_file="$(bashio::config 'ssl_tls.certificate_file')"
private_key_file="$(bashio::config 'ssl_tls.private_key_file')"

ALL_CONFIGURED="$(bashio::jq "/var/www/localhost/htdocs/config-status.json" ".allConfigured")"

if [[ "${ALL_CONFIGURED}" == "true" ]]; then
	cp /etc/nginx/http.d/tls.conf.template /etc/nginx/http.d/tls.conf
	sed -i \
		-e "s|/ssl/fullchain\.pem|/ssl/${certificate_file}|g" \
		-e "s|/ssl/privkey\.pem|/ssl/${private_key_file}|g" \
		/etc/nginx/http.d/tls.conf

fi

exec nginx -g 'daemon off;'
